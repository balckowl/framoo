{
  "name": "framoo",
  "version": "0.1.0",
  "description": "Camera motion, lyric animation, and atmospheric overlays for Remotion video projects.",
  "keywords": [
    "animation",
    "camera-motion",
    "lyrics",
    "music-video",
    "remotion",
    "video",
    "visual-effects"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./camera/moves": {
      "types": "./dist/camera/moves/index.d.ts",
      "import": "./dist/camera/moves/index.js"
    },
    "./camera/effects": {
      "types": "./dist/camera/effects/index.d.ts",
      "import": "./dist/camera/effects/index.js"
    },
    "./lyrics": {
      "types": "./dist/lyrics/index.d.ts",
      "import": "./dist/lyrics/index.js"
    },
    "./atmosphere": {
      "types": "./dist/atmosphere/index.d.ts",
      "import": "./dist/atmosphere/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:library",
    "build:library": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build:library",
    "prepublishOnly": "npm run check",
    "check": "npm run format:check && npm run lint && npm run build:library && npm run typecheck:playground && npm pack --dry-run --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "studio:playground": "npm run build:library && remotion studio playground/src/index.tsx --public-dir playground/public",
    "typecheck:playground": "tsc --noEmit --project playground/tsconfig.json",
    "check:playground": "npm run build:library && npm run typecheck:playground",
    "dev:studio": "npm run studio:playground",
    "dev:docs": "npm --prefix docs run dev"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.541",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "remotion": "^4.0.541"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
